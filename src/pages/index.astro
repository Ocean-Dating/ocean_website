---
import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ocean - The AI-powered dating app</title>
    <meta name="description" content="Ocean is the AI-powered dating app that helps you find meaningful connections. Available for iOS and Android." />
  </head>
  <body>
    <header class="header">
      <div class="container">
        <nav class="nav">
          <img src="/ocean_wordmark_vector.png" alt="Ocean" class="logo" />
          <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <img src="/ocean_logo_vector.png" alt="Ocean Logo" style="height: 120px; margin-bottom: 2rem;" />
          <h1>Ocean</h1>
          <p>The AI-powered dating app</p>
          <p style="font-size: 1.1rem; margin-bottom: 3rem; opacity: 0.8;">
            Dive into meaningful connections with the power of AI. Ocean helps you find your perfect match through intelligent compatibility matching.
          </p>
          <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="#" class="btn">Download for iOS</a>
            <a href="#" class="btn">Download for Android</a>
          </div>
        </div>
      </section>

      <section style="padding: 4rem 0;">
        <div class="container">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; text-align: center;">
            <div>
              <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">AI-Powered Matching</h3>
              <p style="opacity: 0.9;">Our advanced AI learns your preferences and finds compatible matches based on deeper connections.</p>
            </div>
            <div>
              <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Meaningful Conversations</h3>
              <p style="opacity: 0.9;">Smart conversation starters help you break the ice and build genuine connections.</p>
            </div>
            <div>
              <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Safe & Secure</h3>
              <p style="opacity: 0.9;">Your privacy and safety are our top priorities with advanced verification and security features.</p>
            </div>
          </div>
        </div>
      </section>

      <section style="padding: 4rem 0; background-color: rgba(42, 146, 144, 0.5);">
        <div class="container" style="text-align: center;">
          <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">Coming Soon</h2>
          <p style="font-size: 1.2rem; margin-bottom: 2rem; opacity: 0.9;">
            Ocean will be available for iOS and Android devices. Stay tuned for updates!
          </p>
          <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="#" class="btn">Notify Me - iOS</a>
            <a href="#" class="btn">Notify Me - Android</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
          <a href="/blog">Blog</a>
        </div>
        <p>&copy; 2024 Ocean. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
