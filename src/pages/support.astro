---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout
  title="Support - Ocean Dating App"
  description="Get help and support for Ocean. Contact us for assistance with your account, technical issues, or questions about the app."
>
  <Header />
  <main>
    <section class="hero">
      <div class="container">
        <h1>Support</h1>
        <p>We're here to help you with any questions or issues</p>
      </div>
    </section>

    <section>
      <div class="container">
        <div style="max-width: 800px; margin: 0 auto;">

          <div style="margin-bottom: 3rem;">
            <h2 style="font-size: 1.8rem; margin-bottom: 1.5rem;">Contact Us</h2>
            <p style="line-height: 1.8; opacity: 0.9;">
              If you need help with Ocean, have questions, or want to report an issue, please contact our support team:
            </p>
            <p style="line-height: 1.8; opacity: 0.9; margin-top: 1.5rem; font-size: 1.2rem;">
              <strong>Email:</strong> <a href="mailto:support@oceandating.app">support@oceandating.app</a>
            </p>
            <p style="line-height: 1.8; opacity: 0.9; margin-top: 1rem;">
              We typically respond within 24-48 hours.
            </p>
          </div>

          <div style="margin-bottom: 3rem;">
            <h2 style="font-size: 1.8rem; margin-bottom: 1.5rem;">Common Questions</h2>

            <div style="margin-bottom: 2rem;">
              <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">How do I create an account?</h3>
              <p style="line-height: 1.8; opacity: 0.9;">
                Download the Ocean app from the App Store (iOS) or Google Play Store (Android) and follow the signup process. You'll need to provide a phone number for verification.
              </p>
            </div>

            <div style="margin-bottom: 2rem;">
              <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">How does AI matching work?</h3>
              <p style="line-height: 1.8; opacity: 0.9;">
                Ocean uses advanced AI to analyze your profile information, preferences, and photos to find compatible matches. Our AI generates compatibility scores and explanations to help you find meaningful connections.
              </p>
            </div>

            <div style="margin-bottom: 2rem;">
              <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">Is Ocean free to use?</h3>
              <p style="line-height: 1.8; opacity: 0.9;">
                Yes! All filters (including height filters) are free forever. We believe everyone should have access to the tools they need to find their perfect match.
              </p>
            </div>

            <div style="margin-bottom: 2rem;">
              <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">How do I delete my account?</h3>
              <p style="line-height: 1.8; opacity: 0.9;">
                You can delete your account at any time through the app settings, or by visiting our <a href="/privacy/delete-account">account deletion page</a>. You can also contact our support team for assistance.
              </p>
            </div>

            <div style="margin-bottom: 2rem;">
              <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">How do I report a user?</h3>
              <p style="line-height: 1.8; opacity: 0.9;">
                If you encounter inappropriate behavior, you can report users directly through the app. Our moderation team reviews all reports and takes appropriate action to keep the Ocean community safe.
              </p>
            </div>
          </div>

          <div style="margin-bottom: 3rem;">
            <h2 style="font-size: 1.8rem; margin-bottom: 1.5rem;">Privacy & Legal</h2>
            <p style="line-height: 1.8; opacity: 0.9;">
              For information about how we protect your data and your rights as a user, please see:
            </p>
            <ul style="line-height: 1.8; opacity: 0.9; margin-top: 1rem;">
              <li><a href="/privacy">Privacy Policy</a></li>
              <li><a href="/terms">Terms of Service</a></li>
              <li><a href="/privacy/delete-account">Delete Your Account</a></li>
            </ul>
          </div>

          <div>
            <h2 style="font-size: 1.8rem; margin-bottom: 1.5rem;">Company Information</h2>
            <p style="line-height: 1.8; opacity: 0.9;">
              <strong>Crystal Dating, Inc.</strong><br />
              3229 Greenpoint Ave PMB 107<br />
              Long Island City, NY 11101<br />
              United States<br />
              Email: <a href="mailto:support@oceandating.app">support@oceandating.app</a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
