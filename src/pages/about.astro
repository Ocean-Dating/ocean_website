---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout
  title="About Ocean - The AI-powered dating app"
  description="Learn about Ocean, the AI-powered dating app that helps you find meaningful connections through intelligent compatibility matching."
>
  <Header />
  
  <main>
    <section class="hero">
      <div class="container">
        <h1>About Ocean</h1>
        <p>Revolutionizing online dating with artificial intelligence</p>
      </div>
    </section>

    <section style="padding: 4rem 0;">
      <div class="container">
        <div style="max-width: 800px; margin: 0 auto;">
          <h2 style="font-size: 2rem; margin-bottom: 2rem; text-align: center;">Our Mission</h2>
          <p style="font-size: 1.2rem; line-height: 1.8; margin-bottom: 3rem; opacity: 0.9;">
            At Ocean, we believe that finding love shouldn't be left to chance. Our mission is to create meaningful connections 
            by leveraging the power of artificial intelligence to understand compatibility beyond surface-level preferences.
          </p>

          <h2 style="font-size: 2rem; margin-bottom: 2rem; text-align: center;">What Makes Ocean Different</h2>
          
          <div style="display: grid; gap: 2rem; margin-bottom: 3rem;">
            <div style="background-color: rgba(42, 146, 144, 0.3); padding: 2rem; border-radius: 10px;">
              <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">Intelligent Matching</h3>
              <p style="opacity: 0.9;">Our AI analyzes communication patterns, interests, and values to find matches that truly complement you.</p>
            </div>
            
            <div style="background-color: rgba(42, 146, 144, 0.3); padding: 2rem; border-radius: 10px;">
              <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">Conversation Starters</h3>
              <p style="opacity: 0.9;">Break the ice with AI-generated conversation starters tailored to your match's interests and personality.</p>
            </div>
            
            <div style="background-color: rgba(42, 146, 144, 0.3); padding: 2rem; border-radius: 10px;">
              <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">Privacy First</h3>
              <p style="opacity: 0.9;">Your data is protected with enterprise-grade security, and our AI learns without compromising your privacy.</p>
            </div>
          </div>

          <h2 style="font-size: 2rem; margin-bottom: 2rem; text-align: center;">The Future of Dating</h2>
          <p style="font-size: 1.2rem; line-height: 1.8; opacity: 0.9; text-align: center;">
            Ocean is more than just a dating app – it's a platform designed to foster genuine connections in an increasingly digital world. 
            We're committed to helping you find not just a match, but a meaningful relationship that lasts.
          </p>
        </div>
      </div>
    </section>

    <section style="padding: 4rem 0; background-color: rgba(42, 146, 144, 0.5);">
      <div class="container" style="text-align: center;">
        <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">Ready to Dive In?</h2>
        <p style="font-size: 1.2rem; margin-bottom: 2rem; opacity: 0.9;">
          Join the waiting list to be notified when Ocean launches.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="#" class="btn">Notify Me - iOS</a>
          <a href="#" class="btn">Notify Me - Android</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>