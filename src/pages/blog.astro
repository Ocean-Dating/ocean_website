---
import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog - Ocean Dating App</title>
    <meta name="description" content="Read the latest insights about AI-powered dating, relationship advice, and updates from the Ocean team." />
  </head>
  <body>
    <header class="header">
      <div class="container">
        <nav class="nav">
          <img src="/ocean_wordmark_vector.png" alt="Ocean" class="logo" />
          <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <h1>Ocean Blog</h1>
          <p>Insights on AI-powered dating and meaningful connections</p>
        </div>
      </section>

      <section style="padding: 4rem 0;">
        <div class="container">
          <div style="max-width: 800px; margin: 0 auto;">
            <div style="text-align: center; margin-bottom: 4rem;">
              <h2 style="font-size: 2rem; margin-bottom: 1rem;">Coming Soon</h2>
              <p style="font-size: 1.2rem; opacity: 0.9;">
                We're working on creating valuable content about dating, relationships, and the future of AI-powered connections. 
                Stay tuned for our first blog posts!
              </p>
            </div>

            <div style="display: grid; gap: 2rem;">
              <div style="background-color: rgba(42, 146, 144, 0.3); padding: 2rem; border-radius: 10px;">
                <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">What to Expect</h3>
                <ul style="list-style: none; padding: 0;">
                  <li style="margin-bottom: 0.5rem; opacity: 0.9;">• Dating tips and relationship advice</li>
                  <li style="margin-bottom: 0.5rem; opacity: 0.9;">• Insights into AI and technology in dating</li>
                  <li style="margin-bottom: 0.5rem; opacity: 0.9;">• Success stories from the Ocean community</li>
                  <li style="margin-bottom: 0.5rem; opacity: 0.9;">• Product updates and new features</li>
                  <li style="margin-bottom: 0.5rem; opacity: 0.9;">• Research on modern dating trends</li>
                </ul>
              </div>

              <div style="background-color: rgba(42, 146, 144, 0.3); padding: 2rem; border-radius: 10px;">
                <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">Stay Updated</h3>
                <p style="opacity: 0.9; margin-bottom: 1rem;">
                  Want to be notified when we publish new blog posts? Join our mailing list to stay in the loop 
                  about Ocean updates and dating insights.
                </p>
                <a href="#" class="btn">Subscribe to Updates</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section style="padding: 4rem 0; background-color: rgba(42, 146, 144, 0.5);">
        <div class="container" style="text-align: center;">
          <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">Ready for Ocean?</h2>
          <p style="font-size: 1.2rem; margin-bottom: 2rem; opacity: 0.9;">
            Be the first to experience AI-powered dating when Ocean launches.
          </p>
          <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="#" class="btn">Notify Me - iOS</a>
            <a href="#" class="btn">Notify Me - Android</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
          <a href="/blog">Blog</a>
        </div>
        <p>&copy; 2025 Ocean. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>